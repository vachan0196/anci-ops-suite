# Base64-encoded 32-byte AES-GCM key. Generate with:
# openssl rand -base64 32
# Required for 2FA enrolment. Never commit a real value.
TOTP_ENCRYPTION_KEY=replace-with-generated-development-secret

# staging and production only. The real value never lives in this repository
# and is supplied at runtime from outside it (D068 rule 5). No live credential
# exists on a development machine.
RESEND_API_KEY=
